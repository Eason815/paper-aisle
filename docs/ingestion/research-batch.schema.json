{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Stage 01 research batch",
  "description": "调研主表契约；证据支持、跨记录唯一性及人工确认真实性还须事实核查。website paper定义取自2026-10-22实际项目。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "scope",
    "questionCatalog",
    "records",
    "processingLog"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "venues",
        "description"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999
        },
        "venues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "questionCatalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/researchRecord"
      }
    },
    "processingLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "status",
          "details"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "blocked"
            ]
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "official": {
          "type": "string",
          "format": "uri"
        },
        "pdf": {
          "type": "string",
          "format": "uri"
        },
        "review": {
          "type": "string",
          "format": "uri"
        },
        "project": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "notableInstitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "company",
            "university",
            "research"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/author"
          }
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 9999
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "subdirection": {
          "type": "string",
          "minLength": 1
        },
        "presentationType": {
          "type": "string",
          "minLength": 1
        },
        "displayLevel": {
          "deprecated": true,
          "description": "兼容旧数据；新数据请使用 presentationType。",
          "type": "string",
          "minLength": 1
        },
        "contributionTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "highlighted": {
          "type": "boolean"
        },
        "recommendationScore": {
          "type": "number"
        },
        "quickRead": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "problem": {
              "type": "string",
              "minLength": 1
            },
            "finding": {
              "type": "string",
              "minLength": 1
            },
            "approach": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "researchQuestion": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "string",
          "minLength": 1
        },
        "innovations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "significance": {
          "type": "string",
          "minLength": 1
        },
        "abstractExcerpt": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "$ref": "#/$defs/links"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q[0-9]{2,}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason"
      ],
      "properties": {
        "decision": {
          "enum": [
            "candidate",
            "included",
            "excluded",
            "supplement"
          ]
        },
        "suggestedDecision": {
          "enum": [
            "included",
            "excluded",
            "supplement",
            "defer"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "Core",
            "Related",
            "Edge"
          ]
        },
        "suggestedRole": {
          "enum": [
            "Core",
            "Related",
            "Edge"
          ]
        },
        "mainQuestionId": {
          "type": "string",
          "pattern": "^Q[0-9]{2,}$"
        },
        "secondaryQuestionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^Q[0-9]{2,}$"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLevel",
        "track",
        "trackVerified",
        "humanConfirmed"
      ],
      "properties": {
        "sourceLevel": {
          "enum": [
            "title",
            "abstract",
            "fulltext"
          ]
        },
        "track": {
          "enum": [
            "main",
            "findings",
            "workshop",
            "datasets",
            "preprint",
            "unknown"
          ]
        },
        "trackLabel": {
          "type": "string",
          "minLength": 1
        },
        "trackVerified": {
          "type": "boolean"
        },
        "humanConfirmed": {
          "type": "boolean"
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "readSections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "locator",
        "supports",
        "claimType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "claimType": {
          "enum": [
            "fact",
            "author_claim",
            "judgment"
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "aiSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "generator",
        "humanChecked"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "approach": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "problem": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "finding": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "approach": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "humanChecked": {
          "type": "boolean"
        }
      }
    },
    "researchRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "review",
        "verification",
        "evidence",
        "aiSummary"
      ],
      "properties": {
        "paper": {
          "$ref": "#/$defs/paper"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "aiSummary": {
          "$ref": "#/$defs/aiSummary"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "properties": {
                  "sourceLevel": {
                    "const": "title"
                  }
                },
                "required": [
                  "sourceLevel"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "aiSummary": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "problem"
                      ]
                    },
                    {
                      "required": [
                        "finding"
                      ]
                    },
                    {
                      "required": [
                        "approach"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
