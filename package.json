{
  "name": "paper-aisle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run research:validate && npm run build && npm run typecheck:test && npm test",
    "data:preview": "node scripts/import-research.mjs",
    "data:import": "node scripts/import-research.mjs --write",
    "research:validate": "node scripts/research-workflow.mjs validate",
    "research:status": "node scripts/research-workflow.mjs status",
    "research:sync": "node scripts/research-workflow.mjs sync",
    "research:resume": "node scripts/research-workflow.mjs resume"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "^2.3.7",
    "@supabase/supabase-js": "2.105.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
